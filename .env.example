# ==============================================================================
# fbchat-v2 Provider Microservice - Environment Configuration
# ==============================================================================

# Puerto y Host del servicio HTTP / WebSocket
# FBCHAT_PORT: Puerto interno en el que escucha el servidor (por defecto 8080)
# FBCHAT_HOST_PORT: Puerto expuesto en el host al usar Docker Compose (por defecto 8088)
# FBCHAT_HOST: Interfaz de escucha (por defecto 0.0.0.0)
FBCHAT_PORT=8080
FBCHAT_HOST_PORT=8088
FBCHAT_HOST=0.0.0.0

# Autenticación HTTP Basic (protege la API REST, WebSocket y Portal)
FBCHAT_API_AUTH_REQUIRED=true
FBCHAT_API_USERNAME=provider
FBCHAT_API_PASSWORD=cambia_este_password_super_seguro

# Requerimiento del Bridge E2EE (Go)
# "true" en entornos de producción con el bridge compilado
# "false" si se ejecuta de forma local/desarrollo sin compilar el submódulo Go
FBCHAT_E2EE_REQUIRED=false

# Directorio donde se persisten sesiones cifradas, metadatos y medios en staging
# En Docker: /var/lib/fbchat
# En desarrollo local: ./.tmp/fbchat-state
FBCHAT_STATE_DIR=/var/lib/fbchat

# Persistencia de sesiones cifradas en reposo
FBCHAT_PERSIST_SESSIONS=true

# Permitir despacho de webhooks a hosts locales/internos (ej. backend de SocialManager)
FBCHAT_ALLOW_INTERNAL_WEBHOOK=true

# Ruta al binario ejecutable del bridge E2EE (opcional si está en el PATH estándar)
# FBCHAT_E2EE_BIN=/usr/local/bin/fbchat-bridge-e2ee
